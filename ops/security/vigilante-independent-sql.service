[Unit]
Description=Copias SQL acotadas de bases independientes
After=mariadb.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/vigilante/vigilante-independent-sql.py
User=root
UMask=0077
StateDirectory=vigilante-independent-sql
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
CapabilityBoundingSet=
InaccessiblePaths=/var/www /var/lib/mysql /etc/mysql /var/lib/vigilante-auth /var/lib/vigilante-wa /srv/vigilante-ai
ReadWritePaths=/var/backup/vigilante-independent-sql
CPUQuota=75%
MemoryMax=192M
TasksMax=16
Nice=10
IOWeight=10
TimeoutStartSec=30s
TimeoutStopSec=5s
LimitFSIZE=32M
LimitCORE=0
Restart=no
