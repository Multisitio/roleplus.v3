[Unit]
Description=Ensayo manual de recuperacion de todos los textos seleccionados

[Service]
Type=oneshot
DynamicUser=yes
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/vigilante/vigilante-text-restore.py
StateDirectory=vigilante-text-restore
StateDirectoryMode=0700
RuntimeDirectory=vigilante-text-restore
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
InaccessiblePaths=/var/www /var/lib/mysql /run/mysqld /etc/mysql /var/backup
InaccessiblePaths=/var/lib/vigilante-auth /var/lib/vigilante-wa /srv/vigilante-ai
NoExecPaths=/run/vigilante-text-restore
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CPUQuota=25%
IOWeight=10
Nice=19
MemoryMax=512M
TasksMax=16
TimeoutStartSec=10min
LimitFSIZE=32M
LimitCORE=0
Restart=no
