[Unit]
Description=Recuperacion aislada de la tabla independiente con error 1932

[Service]
Type=oneshot
DynamicUser=yes
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/vigilante/vigilante-orphan-recovery.py
StateDirectory=vigilante-orphan-recovery
StateDirectoryMode=0700
RuntimeDirectory=vigilante-orphan-recovery
RuntimeDirectoryMode=0700
LoadCredential=usuarios.frm:/srv/vigilante-recovery-input/usuarios.frm
LoadCredential=usuarios.ibd:/srv/vigilante-recovery-input/usuarios.ibd
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
InaccessiblePaths=/var/lib/mysql /run/mysqld /var/www /etc/mysql /var/lib/vigilante-auth /var/lib/vigilante-wa /srv/vigilante-ai
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
CPUQuota=75%
MemoryMax=512M
TasksMax=64
TimeoutStartSec=3min
TimeoutStopSec=35s
LimitCORE=0
Restart=no
