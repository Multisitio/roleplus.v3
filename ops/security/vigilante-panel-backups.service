[Unit]
Description=Copias textuales del panel ISPConfig sin detener escrituras
After=mariadb.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/vigilante/vigilante-panel-backups.py
StateDirectory=vigilante-panel-backups
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
InaccessiblePaths=-/var/lib/vigilante-auth -/var/lib/vigilante-whatsapp
ReadWritePaths=/var/backup /var/lib/vigilante-panel-backups
CPUQuota=25%
MemoryMax=256M
TasksMax=16
TimeoutStartSec=180s
TimeoutStopSec=3s
LimitFSIZE=600M
LimitCORE=0
Nice=19
IOWeight=10
Restart=no
