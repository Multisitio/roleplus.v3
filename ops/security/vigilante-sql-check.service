[Unit]
Description=Ensayo aislado de copia SQL y liberacion de bloqueos

[Service]
Type=oneshot
DynamicUser=yes
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/vigilante/vigilante-sql-backup-check.py
StateDirectory=vigilante-sql-check
StateDirectoryMode=0700
RuntimeDirectory=vigilante-sql-check
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
InaccessiblePaths=/var/lib/mysql /run/mysqld /var/www /etc/mysql /var/lib/vigilante-auth /var/lib/vigilante-wa /srv/vigilante-ai
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
CPUQuota=75%
MemoryMax=512M
TasksMax=64
TimeoutStartSec=3min
TimeoutStopSec=35s
LimitCORE=0
Restart=no
