/var/www/clients/client1/web6/private/var/observability/requests.jsonl /var/www/clients/client1/web6/private/var/observability/fpm.jsonl /var/www/clients/client1/web6/private/var/observability/slow.log {
    daily
    maxsize 10M
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    su web6 client1
