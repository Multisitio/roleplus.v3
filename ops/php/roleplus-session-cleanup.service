[Unit]
Description=Conservative cleanup of expired RolePlus sessions

[Service]
Type=oneshot
User=web6
Group=client1
ExecStart=/usr/bin/python3 -B /var/www/clients/client1/web6/private/ops/php/clean-roleplus-sessions.py
Nice=19
IOSchedulingClass=idle
CPUQuota=10%
TimeoutStartSec=300
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/www/clients/client1/web6/tmp
RestrictAddressFamilies=AF_UNIX
