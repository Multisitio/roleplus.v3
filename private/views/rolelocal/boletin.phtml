if ($accion === 'enviar') {
    $year    = date('y');
    $week    = date('W', strtotime('-1 week'));
    $boletin = "boletin-{$year}-{$week}";
    $delayMinMicroseconds = 3 * 1000 * 1000;
    $delayMaxMicroseconds = 5 * 1000 * 1000;
    $totalRecipients = count($usuarios);
    $sentCount = 0;
    $failedCount = 0;
    $startedAt = microtime(true);

    // -----------------------------------------------------------
    // ARRAY DE USUARIOS DE PRUEBA (descomentar para test)
    // -----------------------------------------------------------
    
    /*unset($usuarios);
    $usuarios[0]        = new stdClass();
    $usuarios[0]->email = 'distrotuz@gmail.com';
    $usuarios[0]->token = 'token';*/

    foreach ($usuarios as $index => $u) {
        if (filter_var($u->email, FILTER_VALIDATE_EMAIL)) {
            $uns  = DOMAIN . 'usuarios/baja_del_boletin/' . $u->token;
            $body = replacePlaceholders($html, $uns, $u->email, $boletin);

            $sent = _mail::send($u->email, $titulo, $body, [
                'List-Unsubscribe' => "<mailto:baja@roleplus.app?subject=baja-del-boletin>, <{$uns}>",
                'List-Unsubscribe-Post' => 'List-Unsubscribe=One-Click',
            ]);

            if ($sent) {
                $sentCount++;
            } else {
                $failedCount++;
            }
        } else {
            $failedCount++;
        }

        $processed = $index + 1;
        if ($processed % 100 === 0 || $processed === $totalRecipients) {
            error_log(sprintf(
                'ROLEplus newsletter %s: %d/%d processed, %d sent, %d failed, %ds elapsed.',
                $boletin,
                $processed,
                $totalRecipients,
                $sentCount,
                $failedCount,
                (int) (microtime(true) - $startedAt)
            ));
        }

        // The local Postfix queue handles delivery. A small random delay keeps
        // enqueueing smooth without turning a weekly bulletin into a 13-hour job.
        if ($processed < $totalRecipients) {
            usleep(random_int($delayMinMicroseconds, $delayMaxMicroseconds));
        }
    }
