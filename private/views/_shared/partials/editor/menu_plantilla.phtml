								<?php endfor; ?>
							<?php else: ?>
								<?php for ($i = 8; $i <= 72; $i += 2): $px = "{$i}px"; ?>
									<option value="<?=$px?>" <?=$f['size'] == $px ? 'selected' : ''?>><?=$px?></option>
								<?php endfor; ?>
							<?php endif; ?>
						</select>

						<?php foreach (['variant', 'align', 'transform', 'decoration'] as $control):
							$current = $control === 'variant' ? $variant : $f[$control];
						?>
							<select class="<?=$control?>-select" name="<?=$control?>_<?=$niv?>" data-change-ajax>
								<?php foreach ($menu_plantilla['tipografia_controles'][$control] as $value => $label): ?>
									<option value="<?=$value?>" <?=$current == $value || ($control === 'decoration' && $value === '0' && $current === 'none') ? 'selected' : ''?>><?=t($label)?></option>
								<?php endforeach; ?>
							</select>
						<?php endforeach; ?>

						<div class="web-color-picker" data-nivel="<?=$niv?>" onclick="window.PSColorPicker.open(this)" style="background-color: <?=h($f['color'])?>;"></div>
						<input type="hidden" name="color_<?=$niv?>" value="<?=h($f['color'])?>" data-change-ajax>
						<input type="hidden" name="fuente_<?=$niv?>" value="<?=h($f['fuente'])?>">
					</section>
				<?php endforeach; ?>
			</div>
		</details>

		<input type="hidden" name="manuales_idu" value="<?=$manuales_idu?>">
	</form>
</aside>
